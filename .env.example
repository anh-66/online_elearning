APP_NAME=EduLearn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=online_elearning
DB_USERNAME=root
DB_PASSWORD=
# Bật SSL khi dùng MySQL cloud (Aiven, TiDB Cloud): đường dẫn tới file CA.
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Đặt CLOUDINARY_URL để lưu file upload lên Cloudinary thay vì storage/app/public.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=online-elearning
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Trên Render: MAIL_MAILER=brevo + BREVO_API_KEY (Render gói Free chặn cổng SMTP).
# Ở máy cá nhân để MAIL_MAILER=log: mail (kể cả mã OTP) được ghi vào storage/logs/laravel.log
# và xem được ở trang Admin > Email đã gửi.
BREVO_API_KEY=
# Đặt false để tắt bước nhập mã OTP xác thực email khi đăng ký.
EMAIL_OTP_ENABLED=true
# Số mail OTP tối đa cả web gửi trong một ngày (gói Free của Brevo cho 300 mail/ngày).
EMAIL_OTP_MAX_PER_DAY=250

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Chat AI tư vấn khóa học (Google Gemini, gói miễn phí). Lấy key ở https://aistudio.google.com/apikey
# Để trống thì khung chat bị ẩn. Đừng bật billing để không bao giờ bị tính tiền.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
